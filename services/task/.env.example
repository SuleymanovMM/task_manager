APP_NAME=taskflow-task
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://task:task@postgres:5432/task_db

JWT_PUBLIC_KEY_PATH=./secrets/public.pem
JWT_ALGORITHM=RS256

PROJECT_SERVICE_URL=http://project:8001
PROJECT_SERVICE_TIMEOUT_SECONDS=5
PROJECT_SERVICE_RETRIES=1

REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=300
PROJECT_MEMBER_CACHE_TTL_SECONDS=60

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=taskflow.events
OUTBOX_POLL_SECONDS=1.0

CORS_ORIGINS=
