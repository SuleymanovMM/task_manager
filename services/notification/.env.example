APP_NAME=taskflow-notification
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8003
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://notification:notification@localhost:5432/notification_db
JWT_PUBLIC_KEY_PATH=./secrets/public.pem
JWT_ALGORITHM=RS256
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=taskflow.events
RABBITMQ_DLX_EXCHANGE=taskflow.events.dlq
RABBITMQ_QUEUE=notification-service.notifications
RABBITMQ_DLQ=notification-service.notifications.dlq
RABBITMQ_MAX_RETRIES=3
CONSUMER_NAME=notification-service
