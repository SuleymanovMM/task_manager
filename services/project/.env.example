APP_NAME=taskflow-project
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://project:project@postgres:5432/project_db
JWT_PUBLIC_KEY_PATH=./secrets/public.pem
JWT_ALGORITHM=RS256
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=taskflow.events
CORS_ORIGINS=http://localhost:3000
